# ==============================================================================
# Autonomous SDLC Inception Engine (ASIE) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env in the sdlc-automation directory:
# cp .env.example .env
#
# NOTE: If no LLM API key is provided, ASIE automatically falls back to its
# built-in Intelligent Heuristic Synthesis Engine, generating full specifications
# offline with zero API cost!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary LLM Provider API Keys (Pick one or leave blank for offline engine)
# ------------------------------------------------------------------------------

# Option A: OpenAI (Recommended for gpt-4o / gpt-4o-mini structured outputs)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Option B: Google Gemini (Recommended for gemini-1.5-pro / gemini-1.5-flash)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro

# Option C: Anthropic Claude (Recommended for claude-3-5-sonnet)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# ------------------------------------------------------------------------------
# 2. Engine Execution Settings
# ------------------------------------------------------------------------------
# Mode: "auto" (uses LLM if key present, else offline heuristic), "llm_only", or "offline_only"
ASIE_MODE=auto

# Default output directory for generated specifications
ASIE_OUTPUT_DIR=./generated_specs

# Enable detailed terminal logging of agent transitions (true/false)
ASIE_VERBOSE=true

# Quality score threshold for critic agent approval (0-100)
ASIE_QUALITY_THRESHOLD=90

# ------------------------------------------------------------------------------
# 3. Third-Party Integrations (Optional)
# ------------------------------------------------------------------------------

# Linear Backlog Integration (Auto-creates Epics, Issues & Story Points)
LINEAR_API_KEY=lin_api_your_key_here
LINEAR_TEAM_ID=your_team_uuid_here

# Atlassian Jira Integration
JIRA_HOST=https://your-domain.atlassian.net
JIRA_EMAIL=engineer@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=DEV

# GitHub CI/CD Integration
GITHUB_TOKEN=ghp_your_github_personal_access_token
