{
  "appId": "com.cardem.enthusiast",
  "appName": "Cardem",
  "webDir": "build",
  "bundledWebRuntime": false,
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#080c15",
      "showSpinner": true,
      "androidSpinnerStyle": "large",
      "iosSpinnerStyle": "small"
    },
    "Geolocation": {
      "requestAlwaysPermission": true
    }
  },
  "server": {
    "cleartext": true
  }
}
